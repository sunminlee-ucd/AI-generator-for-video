GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Fast mobile preview profile. These do not need to be set in Cloud Run unless you want
# to override the defaults.
PREVIEW_MAX_DIMENSION=1280
PREVIEW_CRF=28
PREVIEW_PRESET=ultrafast
PREVIEW_AUDIO_BITRATE=96k

WAN_REPO_PATH=/opt/Wan2.2
WAN_CKPT_DIR=/opt/models/Wan2.2-TI2V-5B
WAN_PYTHON_BIN=python
WAN_TASK=ti2v-5B
WAN_SIZE=1280*704
WAN_FRAME_NUM=49

DATA_DIR=./data
MAX_UPLOAD_MB=500
